# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data, models, caches, job files and pipeline output (never committed)
data/
out/

# Viewer build artefacts (viewer/.gitignore covers node_modules, dist, test-results)
viewer/node_modules/
viewer/dist/

# Desktop build artefacts
dist/
build/
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Large binary rasters; eval runs keep CSV/JSON/PNG, not raw grids
*.bin
evals/results/**/*.tif
evals/results/**/previews/

# Logs and environment
*.log
.env
.env.*
.DS_Store
Thumbs.db
